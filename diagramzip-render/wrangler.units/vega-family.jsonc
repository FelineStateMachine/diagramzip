{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "diagramzip-render-vega-family",
  "main": "../src/units/vega-family.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "logs": { "head_sampling_rate": 1 } },
  "vars": { "RENDERER_BUILD": "vega-6.3.1-vegalite-6.4.3-unit-1" },
  "routes": [
    { "pattern": "vega.render.diagram.zip", "custom_domain": true },
    { "pattern": "vegalite.render.diagram.zip", "custom_domain": true }
  ]
}
