{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "diagramzip-render-wavedrom",
  "main": "../src/units/wavedrom.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "logs": { "head_sampling_rate": 1 } },
  "vars": { "RENDERER_BUILD": "wavedrom-3.6.2-unit-1" },
  "routes": [{ "pattern": "wavedrom.render.diagram.zip", "custom_domain": true }]
}
