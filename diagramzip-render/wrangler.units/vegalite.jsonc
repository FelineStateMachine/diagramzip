{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "diagramzip-render-vegalite",
  "main": "../src/units/vegalite.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "logs": { "head_sampling_rate": 1 } },
  "vars": { "RENDERER_BUILD": "vegalite-6.4.3-vega-6.3.1-unit-1" },
  "routes": [{ "pattern": "vegalite.render.diagram.zip", "custom_domain": true }]
}
