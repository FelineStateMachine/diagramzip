{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "diagramzip-render-structurizr",
  "main": "../src/units/structurizr.ts",
  "compatibility_date": "2026-08-20",
  "observability": { "enabled": true, "logs": { "head_sampling_rate": 1 } },
  "vars": { "RENDERER_BUILD": "structurizr-6.2.2-plantuml-translation-1" },
  "services": [
    { "binding": "PLANTUML", "service": "diagramzip-render-plantuml-family" }
  ],
  "routes": [
    { "pattern": "structurizr.render.diagram.zip", "custom_domain": true }
  ]
}
