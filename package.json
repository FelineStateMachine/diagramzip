{
  "name": "kroki-ci",
  "version": "1.0.0",
  "description": "Utility scripts for continuous integration",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "private": true,
  "scripts": {
    "build:diagramzip": "vite build --config diagramzip/vite.config.js && vite build --config diagramzip/vite.renderer.config.js",
    "dev:diagramzip": "vite --config diagramzip/vite.config.js",
    "test": "node --test-force-exit ci/tests/smoke.js",
    "test:diagramzip": "node --test diagramzip/test/*.test.js",
    "update-versions": "node ci/tasks/update-versions.js"
  },
  "volta": {
    "node": "24.19.0"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@lezer/highlight": "^1.2.3",
    "blocked-at": "^1.2.0",
    "codemirror": "^6.0.2",
    "mermaid": "11.17.0",
    "pako": "^3.0.1",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "vite": "^8.2.2"
  }
}
