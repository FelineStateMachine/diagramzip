{
  "name": "kroki-ci",
  "version": "1.0.0",
  "description": "Utility scripts for continuous integration",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "private": true,
  "scripts": {
    "build:diagramzip": "vite build --config diagramzip/vite.config.js",
    "generate:diagramzip-docs": "npm --prefix diagramzip-docs run generate",
    "check:diagramzip-docs": "npm --prefix diagramzip-docs run check",
    "build:diagramzip-docs": "npm --prefix diagramzip-docs run build",
    "dev:diagramzip": "vite --config diagramzip/vite.config.js",
    "test": "node --test-force-exit ci/tests/smoke.js",
    "test:diagramzip": "node --test diagramzip/test/*.test.js",
    "update-versions": "node ci/tasks/update-versions.js"
  },
  "volta": {
    "node": "24.19.0"
  },
  "dependencies": {
    "blocked-at": "^1.2.0",
    "monaco-editor": "^0.56.0",
    "pako": "^3.0.1",
    "saxes": "6.0.0"
  },
  "overrides": {
    "dompurify": "3.4.14"
  },
  "devDependencies": {
    "vite": "^8.2.2"
  }
}
