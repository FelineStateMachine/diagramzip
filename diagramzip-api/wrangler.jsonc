{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "diagramzip-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "RENDERER_BUILD": "kroki-0.32.1"
  },
  "routes": [
    {
      "pattern": "diagram.zip/api/v1/*",
      "zone_name": "diagram.zip"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "diagramzip",
      "database_id": "bc2c7bd3-8071-40a2-b496-2751ce60b2b8",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CONTENT",
      "bucket_name": "diagramzip-content"
    }
  ]
}
