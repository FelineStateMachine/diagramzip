{
  "name": "diagramzip-render",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate:types": "wrangler types ../catalog/worker-configuration.d.ts --config ../catalog/wrangler.jsonc",
    "generate:licenses": "node scripts/check-runtime-licenses.mjs --write",
    "build:dbml": "node scripts/build/dbml.mjs",
    "build:d2": "node scripts/build/d2.mjs",
    "build:tikz": "node scripts/build/tikz.mjs",
    "check": "tsc --noEmit",
    "check:licenses": "node scripts/check-runtime-licenses.mjs",
    "deploy:dry-run": "wrangler deploy --dry-run --config ../catalog/wrangler.jsonc",
    "deploy:edge": "node scripts/deploy/worker-units.mjs",
    "deploy:python": "node ../scripts/deploy-python-units.mjs",
    "dev:catalog": "wrangler dev --config ../catalog/wrangler.jsonc",
    "smoke:catalog": "node ../catalog/scripts/smoke.mjs",
    "smoke:renderers": "node ../scripts/smoke-units.mjs",
    "test": "vitest run --dir .. edge/test catalog/test"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@softwaretechnik/dbml-renderer": "1.0.31",
    "@viz-js/viz": "3.29.0",
    "bytefield-svg": "1.11.0",
    "json5": "2.2.3",
    "linkedom": "0.18.12",
    "nomnoml": "1.7.0",
    "onml": "2.1.0",
    "saxes": "6.0.0",
    "vega": "6.3.1",
    "vega-interpreter": "2.3.2",
    "vega-lite": "6.4.3",
    "wavedrom": "3.6.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260820.1",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
