{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "diagramzip-render-excalidraw",
  "main": "../../src/units/excalidraw.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "logs": { "head_sampling_rate": 1 } },
  "vars": { "RENDERER_BUILD": "excalidraw-0.18.1-edge-dom-1" },
  "routes": [{ "pattern": "excalidraw.render.diagram.zip", "custom_domain": true }]
}
