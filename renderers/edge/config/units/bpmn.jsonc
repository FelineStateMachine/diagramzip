{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "diagramzip-render-bpmn",
  "main": "../../src/units/bpmn.ts",
  "compatibility_date": "2026-08-20",
  "observability": { "enabled": true, "logs": { "head_sampling_rate": 1 } },
  "vars": { "RENDERER_BUILD": "bpmn-direct-svg-1" },
  "routes": [{ "pattern": "bpmn.render.diagram.zip", "custom_domain": true }]
}
