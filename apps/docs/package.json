{
  "name": "diagramzip-docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run generate && docusaurus start",
    "generate": "node scripts/generate-docs.mjs",
    "check": "node scripts/check-docs.mjs",
    "check:rendered-examples": "node scripts/check-rendered-examples.mjs",
    "test": "node --test test/*.test.mjs",
    "build": "npm run generate && npm run check && npm test && docusaurus build",
    "serve": "docusaurus serve",
    "deploy:preview": "wrangler pages deploy build --project-name diagramzip-docs"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "3.1.1",
    "clsx": "2.1.1",
    "prism-react-renderer": "2.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "wrangler": "4.125.0"
  },
  "engines": {
    "node": ">=20.0"
  },
  "overrides": {
    "serialize-javascript": "7.1.0",
    "sockjs": {
      "uuid": "11.1.1"
    }
  }
}
