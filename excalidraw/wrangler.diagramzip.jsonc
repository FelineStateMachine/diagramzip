{
  "$schema": "../diagramzip-render/node_modules/wrangler/config-schema.json",
  "name": "diagramzip-render-excalidraw",
  "main": "./diagramzip-unit/worker.js",
  "compatibility_date": "2026-08-20",
  "assets": {
    "directory": "./diagramzip-unit-dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/v1/*"]
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "excalidraw.render.diagram.zip",
      "custom_domain": true
    }
  ]
}
