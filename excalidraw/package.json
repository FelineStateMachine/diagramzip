{
  "name": "@diagramzip/excalidraw-server",
  "version": "1.0.0",
  "description": "A micro server built on top of the Excalidraw diagram library.",
  "type": "module",
  "main": "src/index.js",
  "bin": "src/index.js",
  "scripts": {
    "prestart": "cp -r ./node_modules/@excalidraw/excalidraw/dist/prod/fonts ./assets/",
    "build": "npx esbuild ./assets/index.js --bundle --minify --outfile=./assets/index.bundle.js",
    "build:diagramzip-unit": "node ./scripts/build-diagramzip-unit.mjs",
    "deploy:diagramzip-unit": "../diagramzip-render/node_modules/.bin/wrangler deploy --config wrangler.diagramzip.jsonc",
    "start": "node src/index.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "biome check src"
  },
  "keywords": [],
  "author": "Guillaume Grossetie",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FelineStateMachine/diagramzip.git"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@diagramzip/browser-instance": "file:../lib/browser-instance",
    "micro": "10.0.1",
    "pino": "9.14.0",
    "pino-debug": "2.0.0",
    "puppeteer": "25.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "esbuild": "0.28.1"
  },
  "volta": {
    "node": "24.19.0"
  }
}
