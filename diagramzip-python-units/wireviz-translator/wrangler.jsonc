{
  "$schema": "../../diagramzip-render/node_modules/wrangler/config-schema.json",
  "name": "diagramzip-render-wireviz",
  "main": "src/entry.py",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["python_workers"],
  "observability": { "enabled": true, "logs": { "head_sampling_rate": 1 } },
  "vars": { "RENDERER_BUILD": "wireviz-0.3.2-python-dot-1" },
  "services": [
    { "binding": "GRAPHVIZ", "service": "diagramzip-render-graphviz-family" }
  ],
  "routes": [
    { "pattern": "wireviz.render.diagram.zip", "custom_domain": true }
  ]
}
